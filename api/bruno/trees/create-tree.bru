meta {
  name: create-tree
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/trees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      "name": "Chêne pédonculé",
      "species": "Quercus robur",
      "description": "Un grand chêne commun d'Europe.",
      "location": "Forêt de Fontainebleau",
      "co2": 22,
      "oxygen": 118,
      "price": 49.99,
      "imageUrl": "https://example.com/chene.jpg",
      "stock": 10
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
