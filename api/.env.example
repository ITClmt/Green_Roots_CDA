POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# Avec Docker (dev ou prod) : postgres | En local sans Docker : localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app

NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
# Dev : http://localhost:5173 | Prod : URL publique du site (ex. https://mondomaine.fr)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
